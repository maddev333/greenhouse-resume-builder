{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@greenhouse-resume-builder/shared": ["../shared/dist"],
      "@greenhouse-resume-builder/shared/enums": ["../shared/dist/enums"],
      "@greenhouse-resume-builder/shared/interfaces": ["../shared/dist/interfaces"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
