<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Azure App Service (IIS + iisnode) hosting config for the Express API.

  Azure App Service on Windows runs Node behind IIS via the iisnode module.
  Without this file IIS serves the deployed folder as static content and returns
  its own 403/404 for every route (e.g. /ping), so the Node app never receives
  the request. This handler routes all HTTP traffic to the root server.js shim
  (which in turn requires ./dist/server.js).

  NOTE: under iisnode, process.env.PORT is a named pipe (a string), so the app
  must call app.listen(process.env.PORT) WITHOUT coercing it to a Number.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />

    <!-- Tell IIS that server.js is a Node app hosted by the iisnode module. -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Every request that is not a physical file is handled by the Node app. -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let the Node app's own error responses pass through untouched. -->
    <httpErrors existingResponse="PassThrough" />

    <iisnode loggingEnabled="true" devErrorsEnabled="true" />
  </system.webServer>
</configuration>
