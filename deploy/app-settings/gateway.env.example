# Azure App Service settings for engagements-agent-gateway.zip
# Reference only: the deployment ZIP does not load this file.
# Add these values under App Service > Configuration > Application settings.

# Required in a split Azure deployment. Use the runtime base URL only; the gateway appends
# /tools/list, /tools/call, and /run. Never use localhost or append one of those route paths.
ENGAGEMENTS_PYTHON_AGENT_URL=https://<agent-runtime-app>.azurewebsites.net
ENGAGEMENTS_MCP_URL=https://<engagements-mcp-app>.azurewebsites.net/mcp

# Must match RETRIEVAL_BACKEND on the engagements MCP App Service so the gateway does not inject
# the demo catalog while the MCP is serving customer data. Allowed: memory, search, grounding.
RETRIEVAL_BACKEND=grounding

# Required for grounding mode; optional for memory/search mode. The gateway uses these two values
# to enable the Microsoft Agent Framework path. Model authentication happens in the Python runtime.
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<chat-deployment-name>

# Keep this above AGENT_REQUEST_TIMEOUT_SECONDS on the Python runtime.
ENGAGEMENTS_PYTHON_AGENT_TIMEOUT_MS=60000

# Optional Area Discovery MCP. Omit when that service is not deployed.
# DISCOVERY_MCP_URL=https://<discovery-mcp-app>.azurewebsites.net/mcp

# Optional planner defaults.
# ENGAGEMENTS_DEFAULT_LEADER=L1
# ENGAGEMENTS_TOP_N=3
# ENGAGEMENTS_PLAN_WINDOW=2026-10-01..2026-10-31
# ENGAGEMENTS_PLAN_HORIZON_DAYS=25