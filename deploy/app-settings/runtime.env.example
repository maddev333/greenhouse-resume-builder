# Azure App Service settings for engagements-agent-runtime.zip
# Reference only: the deployment ZIP does not load this file.
# Add these values under App Service > Configuration > Application settings.
# Configure the App Service startup command separately as: bash startup.sh

# Required for ZIP deployment so Oryx installs requirements.txt.
SCM_DO_BUILD_DURING_DEPLOYMENT=true

# Required when the gateway enables the Microsoft Agent Framework path.
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<chat-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# Authentication: enable the App Service managed identity and grant it Cognitive Services OpenAI
# User. For a user-assigned identity, set its client id; system-assigned identity needs no setting.
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>

# Key authentication is a fallback. Store the key in Key Vault rather than writing it here.
# AZURE_OPENAI_API_KEY=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/<name>/)

# Keep this below ENGAGEMENTS_PYTHON_AGENT_TIMEOUT_MS on the gateway.
AGENT_REQUEST_TIMEOUT_SECONDS=45

# Agent Governance Toolkit. The policy is packaged at governance/policy.yaml.
AGT_ENABLED=true
# AGENT_ID=engagements-orchestrator
# AGT_POLICY_PATH=governance/policy.yaml
# AGT_AUDIT_MAX_ENTRIES=10000
# AGT_AUDIT_PATH=/home/LogFiles/governance-audit.jsonl

# Optional trusted skill directories, separated by comma or semicolon.
# ENGAGEMENTS_SKILL_PATHS=capabilities/engagements/agent/engagements_agent/skills

# Optional Area Discovery MCP fallback. The gateway normally passes this URL per request.
# DISCOVERY_MCP_URL=https://<discovery-mcp-app>.azurewebsites.net/mcp

# App Service supplies PORT to startup.sh. Do not set ENGAGEMENTS_PYTHON_AGENT_HOST or
# ENGAGEMENTS_PYTHON_AGENT_PORT for the packaged runtime.