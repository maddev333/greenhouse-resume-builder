# Azure App Service settings for engagements-mcp.zip
# Reference only: the deployment ZIP does not load this file.
# Add these values under App Service > Configuration > Application settings.

# Allowed: memory, search, grounding. Set the same value on the gateway App Service.
RETRIEVAL_BACKEND=grounding

# Required for search or grounding; remove these settings for the memory backend.
AZURE_SEARCH_SERVICE=https://<search-service>.search.windows.net

# Authentication: enable the App Service managed identity and grant it Search Index Data Reader.
# For a user-assigned identity, set its client id; system-assigned identity needs no setting.
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>

# Key authentication is a fallback. Store the key in Key Vault rather than writing it here.
# AZURE_SEARCH_API_KEY=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/<name>/)

# Grounding mode loads the packaged config/rag-index.json by default. For a multi-index search
# deployment, package declarations under config/ and enable the directory registry below.
# ENGAGEMENTS_INDEX_SCHEMAS=config

# Optional single-index overrides. Do not combine ENGAGEMENTS_SEARCH_INDEX with a multi-index
# registry, because it would point every declaration at the same index.
# ENGAGEMENTS_INDEX_SCHEMA=config/<index-declaration>.json
# ENGAGEMENTS_SEARCH_INDEX=<index-name>

# Sovereign cloud override; commercial Azure uses search.windows.net.
# AZURE_SEARCH_ENDPOINT_SUFFIX=search.windows.net

# silent | error | warn | info | debug
ENGAGEMENTS_LOG_LEVEL=info

# Azure Maps is baked into the trip-map asset while packaging engagements-mcp.zip. Setting
# AZURE_MAPS_KEY on the deployed App Service does not rebuild that browser asset.

# App Service supplies PORT. Do not set ENGAGEMENTS_MCP_PORT for the packaged service.