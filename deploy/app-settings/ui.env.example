# Azure App Service settings for engagements-ui.zip
# Reference only: the deployment ZIP does not load this file.
# Add these values under App Service > Configuration > Application settings.

# Required in a split Azure deployment.
ORCHESTRATOR_URL=https://<agent-gateway-app>.azurewebsites.net
ENGAGEMENTS_MCP_URL=https://<engagements-mcp-app>.azurewebsites.net/mcp

# Local or custom-hosting ports. Leave unset on a standard App Service deployment.
# HOST_PORT=8080
# SANDBOX_PORT=8081