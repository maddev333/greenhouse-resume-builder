# ── UI (Vite) environment ─────────────────────────────────────
# Vite loads env from THIS folder (ui/). Copy this file to `ui/.env` and fill in the IDs to enable
# Microsoft Entra ID sign-in. Leaving VITE_AZURE_AD_CLIENT_ID unset keeps the UI unauthenticated
# (no sign-in gate) — pair that with ALLOW_DEV_AUTH_BYPASS=true on the API for local development.
#
# VITE_* vars are compiled at build time: restart `npm run dev -w @greenhouse-resume-builder/ui`
# after changing them.

# Browser SPA app registration (single-page-application platform; redirect URI http://localhost:5173).
VITE_AZURE_TENANT_ID=<tenant-id>
VITE_AZURE_AD_CLIENT_ID=<spa-app-registration-client-id>

# Backend API app registration — the UI requests an access token for this audience.
VITE_API_CLIENT_ID=<api-app-registration-client-id>
# Recommended: point at the API's exposed delegated scope (works without admin-consenting .default).
# Falls back to api://<VITE_API_CLIENT_ID>/.default when left blank.
VITE_API_SCOPE=api://<api-app-registration-client-id>/access_as_user

# Gov/DoD cloud: https://login.microsoftonline.us
VITE_AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# Optional: where the API is reached. Defaults to /api/v1 (proxied to http://localhost:3001 in dev).
# VITE_API_URL=/api/v1
# Optional: 'sessionStorage' (default) or 'localStorage' for the MSAL token cache.
# VITE_AUTH_CACHE_LOCATION=sessionStorage

# ── Candidate map (Azure Maps, page 2) ───────────────────────
# Local dev: Azure Maps subscription key for the candidate map on the profile page. OPTIONAL: when unset,
# the dev server automatically reuses AZURE_MAPS_KEY from the repo-root .env (see vite.config.ts). A key set here
# is baked into the client bundle — local dev only. For production, use AAD anonymous auth instead.
VITE_AZURE_MAPS_KEY=

# Production Azure Maps AAD authentication: provide a Maps account client ID and token scope to enable
# browser-based AAD sign-in (anonymous/authenticated) for the map without baking a subscription key into the bundle.
VITE_AZURE_MAPS_CLIENT_ID=
VITE_AZURE_MAPS_TOKEN_SCOPE=https://atlas.microsoft.com/.default

# Geospatial MCP server that geocodes candidate locations into map pins (default below).
VITE_GEOSPATIAL_MCP_URL=http://localhost:7076/api/mcp/geospatial
