# Vite environment variables — these are compiled into your bundled JS.
# Copy this file to .env.local (Vite reads .env.local at runtime) for local dev.

# Azure AD app registration for the SPA (the one that handles login popup).
VITE_AZURE_AD_CLIENT_ID=your-spa-app-registration-client-id-here

# Backend API app registration's client ID — this becomes the `aud` claim in access tokens.
VITE_API_CLIENT_ID=6813db1d-7596-4f97-9060-ccbe4cc57ec1

# Your Azure AD tenant (matches your .env AZURE_TENANT_ID).
VITE_AZURE_TENANT_ID=5a473923-b039-4a6d-b236-16c05b9d6420
