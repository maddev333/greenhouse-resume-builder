{
  "name": "@greenhouse-resume-builder/azure-functions",
  "version": "0.1.0",
  "private": true,
  "main": "dist/**/*.js",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w",
    "start": "func start",
    "start:dev": "concurrently \"npm run watch\" \"func start --lang node --watch\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.0.0",
    "@azure/identity": "^4.2.0",
    "@azure/functions": "^4.16.0",
    "@azure/search-documents": "^13.0.0",
    "@azure/storage-blob": "^12.23.0",
    "@greenhouse-resume-builder/shared": "*",
    "dotenv": "^16.4.0",
    "durable-functions": "^3.3.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.4.0"
  }
}
