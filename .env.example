# Strategic Engagements Travel Planner — environment
#
# EVERYTHING here is OPTIONAL. With no .env at all the demo runs fully offline:
#   - orchestrator uses a deterministic planner (no Azure OpenAI)
#   - retrieval uses the in-memory seed dataset (no Azure AI Search)
#   - the trip map falls back to a schematic dots-and-routes view (no Azure Maps)
#
# Copy to `.env` at the repo root and fill in only the sections you want to enable.

# ── Ports & demo knobs ───────────────────────────────────────
# The engagements MCP server binds ENGAGEMENTS_MCP_PORT, else PORT, else 3010.
# The `demo` script sets this for you; set it here only if you run servers manually.
ENGAGEMENTS_MCP_PORT=3010
ENGAGEMENTS_AGENT_PORT=3020
# Where the chat host / orchestrator find each other (defaults shown).
ENGAGEMENTS_MCP_URL=http://localhost:3010/mcp
ORCHESTRATOR_URL=http://localhost:3020
HOST_PORT=8080
SANDBOX_PORT=8081
# Default persona applied when a request omits x-demo-persona.
# One of: EA_G8 | EA_BASIC | ADMIN | CROSS_TENANT | NO_TENANT
ENGAGEMENTS_DEMO_PERSONA=EA_G8

# ── Retrieval backend ────────────────────────────────────────
# memory  = in-memory seed dataset (default, no cloud needed)
# aisearch = index the seed into Azure AI Search (requires AZURE_SEARCH_* below)
RETRIEVAL_BACKEND=memory

# ── Azure Maps (live basemap tiles — build-time) ─────────────
# Baked into the trip-map App at build time. Without a key the map is schematic.
VITE_AZURE_MAPS_KEY=

# ── Azure OpenAI (LLM planning path — optional) ──────────────
# Set these + `az login` to plan with Azure OpenAI; otherwise a deterministic planner is used.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave the key blank to authenticate with DefaultAzureCredential (az login / managed identity).
AZURE_OPENAI_API_KEY=
# Commercial: https://cognitiveservices.azure.com/.default | Gov: https://cognitiveservices.azure.us/.default
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# ── Azure AI Search (only when RETRIEVAL_BACKEND=aisearch) ────
AZURE_SEARCH_SERVICE=https://<service>.search.windows.net
# Omit the key to use DefaultAzureCredential (az login / managed identity).
AZURE_SEARCH_API_KEY=
# ENGAGEMENTS_SEARCH_INDEX=engagements

# ── Agent governance gate (optional; off by default) ─────────
# When true, mcp-core enforces governance/policy.yaml on every tool call.
GOVERNANCE_ENABLED=false
# GOVERNANCE_POLICY_PATH=governance/policy.yaml
