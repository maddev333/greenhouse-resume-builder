# Strategic Engagements Travel Planner — environment
#
# ONE .env at the repo root is loaded by every process. This file is grouped by APP so you can see
# which variables each one actually reads, and so each Azure Web App only gets the settings it needs.
#
# EVERYTHING here is OPTIONAL. With no .env at all the demo runs fully offline:
#   - the orchestrator uses a deterministic planner (no Azure OpenAI)
#   - retrieval uses the in-memory seed dataset (no Azure AI Search)
#   - the trip map falls back to a schematic dots-and-routes view (no Azure Maps)
#
# Copy to `.env` and fill in only the sections you want to enable.
#
#   APP                     ARTIFACT                          DEFAULT PORT
#   engagements MCP         engagements-mcp.zip               3010
#   area discovery MCP      (not packaged; run locally)       3011
#   agent gateway (TS)      engagements-agent-gateway.zip     3020
#   agent runtime (Python)  engagements-agent-runtime.zip     3030
#   chat UI                 engagements-ui.zip                8080 + 8081
#
# On Azure App Service, PORT is supplied by the platform; the per-app *_PORT variables below are
# for running the stack locally. The `demo` script sets them for you.


# =============================================================================
# SHARED — read by more than one app
# =============================================================================

# ── Azure OpenAI (agent gateway + agent runtime) ─────────────
# Set these + `az login` to plan with Azure OpenAI; otherwise a deterministic planner is used.
# NOTE: setting these only means the LLM path is CONFIGURED, not that it works. Proof that the
# model actually ran is `mode: 'llm'` in the response.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave the key BLANK to authenticate with DefaultAzureCredential (az login / managed identity).
AZURE_OPENAI_API_KEY=
# Commercial: https://cognitiveservices.azure.com/.default | Gov: https://cognitiveservices.azure.us/.default
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# ── Azure Maps (engagements MCP build + discovery MCP runtime)
# Baked into the trip-map App at build time (as VITE_AZURE_MAPS_KEY). Without a key the map
# degrades to a schematic view. ALSO used at runtime by the discovery MCP server for POI search,
# where it is sent as a `subscription-key` HEADER, never in a query string.
AZURE_MAPS_KEY=
# Azure Government: https://atlas.azure.us (default https://atlas.microsoft.com).
# Used by both the browser map control at build time and discovery at runtime.
AZURE_MAPS_ENDPOINT=

# ── Service URLs (who calls whom) ────────────────────────────
# engagements MCP  <- agent gateway, chat UI
ENGAGEMENTS_MCP_URL=http://localhost:3010/mcp
# discovery MCP    <- agent gateway, agent runtime
DISCOVERY_MCP_URL=http://localhost:3011/mcp
# agent gateway    <- chat UI
ORCHESTRATOR_URL=http://localhost:3020


# =============================================================================
# APP: engagements MCP  (engagements-mcp.zip)
# =============================================================================
ENGAGEMENTS_MCP_PORT=3010

# ── Retrieval backend ────────────────────────────────────────
# memory     = in-memory seed dataset (default, no cloud needed)
# search     = Azure AI Search index of STRUCTURED records (contacts/events/leaders/...).
#              Full trip planner. Requires mapping.entityType + mapping.payload in the schema.
# grounding  = Azure AI Search index of DOCUMENTS/CHUNKS (a normal RAG index).
#              Registers ONLY the `search_grounding` tool; the deterministic trip planner is
#              unavailable because a text corpus has no contacts, geo or leader roster.
#              Requires mapping.grounding in the schema. See config/rag-index.json.
#
# IMPORTANT: neither cloud mode falls back to the seed. Requesting one without a configured service
# is a hard error, and in `search` mode NOTHING is read from engagement-intelligence/seed --
# contacts, events, leaders, topics, messages and regions all come from the index, and `today` is
# the real date rather than the seed's demo clock. A record kind the index does not carry reads
# back EMPTY. `grounding` mode touches the seed not at all.
#
# The ORCHESTRATOR reads this too: outside `memory` it keeps the seed's leader roster, topic catalog
# and demo clock out of the model's system prompt, so an empty tool result can never be dressed up
# with demo records. Set it here at the repo root, not only on the MCP server process. `grounding`
# additionally requires AZURE_OPENAI_* -- a document corpus has no deterministic planner.
RETRIEVAL_BACKEND=memory

# ── Azure AI Search (only when RETRIEVAL_BACKEND=search) ─────
AZURE_SEARCH_SERVICE=https://<service>.search.windows.net
# Omit the key to use DefaultAzureCredential (az login / managed identity).
AZURE_SEARCH_API_KEY=
# Override the index named in index-schema.json. Only valid for a SINGLE-declaration registry --
# with several declarations it would collapse them onto one index, and is rejected.
# ENGAGEMENTS_SEARCH_INDEX=engagements
# Point at a different index declaration (fields, types, filterable/searchable, field mapping).
# You do NOT need this for RAG grounding: RETRIEVAL_BACKEND=grounding loads the checked-in
#   capabilities\engagements\mcp\engagements\config\rag-index.json
# by default, and engagements-mcp.zip packages that same file at config/rag-index.json next to the
# process -- so edit the file and set nothing here, locally or in App Service.
# Set this only to load a declaration from somewhere else. A RELATIVE path is resolved against the
# process working directory first and the capability project second; an ABSOLUTE one is used as-is
# but cannot be deployed to a Web App.
# ENGAGEMENTS_INDEX_SCHEMA=C:\path\to\customer-index-schema.json
#
# SEVERAL INDEXES AT ONCE (takes precedence over ENGAGEMENTS_INDEX_SCHEMA). Comma/semicolon
# separated FILE and/or DIRECTORY paths; a directory contributes every *.json in it, sorted by
# filename, skipping *.example.json. Each file holds ONE declaration, so an index is added by
# dropping in a file. Typical layout: one RAG index (the only one with mapping.grounding) plus one
# or more indexes of structured records. Across the whole set the ids must be unique, at most one
# declaration may carry mapping.grounding, and each record kind may be claimed only once.
# See index-schema.structured.example.json and index-schema.grounding.example.json.
#
# DEPLOYABLE FORM -- put every declaration in the capability's config/ directory and name it
# relatively. engagements-mcp.zip ships that whole directory at config/, and a relative path
# resolves against the working directory first and the project second, so this ONE value is right
# under `npm run -w`, from the repo root, and as an App Service app setting:
# ENGAGEMENTS_INDEX_SCHEMAS=config
# Adding an index later is a new file in config/ plus a redeploy -- no setting or code change.
# Sovereign clouds (default search.windows.net).
# AZURE_SEARCH_ENDPOINT_SUFFIX=search.windows.net

# ── Diagnostics ──────────────────────────────────────────────
# silent | error | warn | info (default) | debug -- all output goes to STDERR.
# `info` reports the backend, the loaded index declarations, per-tool timings and per-query hit
# counts. `debug` adds the full search options, OData $filters, ranked hit ids and error stacks.
# Retrieval failures are logged with the setting that has to change (role assignment, indexName,
# semanticConfiguration, ...), not just an HTTP status.
# ENGAGEMENTS_LOG_LEVEL=debug

# ── Seed data (memory backend only) ──────────────────────────
# ENGAGEMENTS_SEED_DIR=engagement-intelligence/seed


# =============================================================================
# APP: area discovery MCP  (run locally; not packaged)
# =============================================================================
DISCOVERY_MCP_PORT=3011
# Abort a discovery lookup after this many ms (default 8000).
DISCOVERY_TIMEOUT_MS=8000
# Also needs AZURE_MAPS_KEY / AZURE_MAPS_ENDPOINT from SHARED above.


# =============================================================================
# APP: agent gateway — TypeScript  (engagements-agent-gateway.zip)
# =============================================================================
ENGAGEMENTS_AGENT_PORT=3020
# All model and deterministic tool calls are sent through the Python runtime.
ENGAGEMENTS_PYTHON_AGENT_URL=http://127.0.0.1:3030
# Keep this ABOVE the Python AGENT_REQUEST_TIMEOUT_SECONDS budget below.
ENGAGEMENTS_PYTHON_AGENT_TIMEOUT_MS=60000

# ── Planner defaults (optional) ──────────────────────────────
# ENGAGEMENTS_DEFAULT_LEADER=L1
# ENGAGEMENTS_PLAN_WINDOW=2025-10-06:2025-10-31
# ENGAGEMENTS_PLAN_HORIZON_DAYS=120
# ENGAGEMENTS_TOP_N=5
# Emit machine-readable JSON from the CLI instead of prose.
# ENGAGEMENTS_AGENT_JSON=true

# Also needs AZURE_OPENAI_*, ENGAGEMENTS_MCP_URL and DISCOVERY_MCP_URL from SHARED above.


# =============================================================================
# APP: agent runtime — Python  (engagements-agent-runtime.zip)
# =============================================================================
ENGAGEMENTS_PYTHON_AGENT_HOST=127.0.0.1
ENGAGEMENTS_PYTHON_AGENT_PORT=3030
# Overall model-run budget and per-MCP-request timeout, in seconds.
AGENT_REQUEST_TIMEOUT_SECONDS=45
# AGENT_ID=engagements-orchestrator

# ── Agent Governance Toolkit ─────────────────────────────────
# Enabled by default. The runtime evaluates governance/policy.yaml before model execution and
# before every model-driven or deterministic MCP tool call.
AGT_ENABLED=true
# AGT_POLICY_PATH=governance/policy.yaml
# Optional append-only JSONL export in addition to AGT's in-memory hash chain.
# Tool argument values and error details are stored as SHA-256 fingerprints.
# AGT_AUDIT_PATH=.local/governance-audit.jsonl
# Rotate the in-memory hash chain after this many entries.
# AGT_AUDIT_MAX_ENTRIES=10000
# Legacy aliases, still honoured if the AGT_* names above are unset.
# GOVERNANCE_POLICY_PATH=governance/policy.yaml
# GOVERNANCE_AUDIT_PATH=.local/governance-audit.jsonl

# Also needs AZURE_OPENAI_* and DISCOVERY_MCP_URL from SHARED above.


# =============================================================================
# APP: chat UI  (engagements-ui.zip)
# =============================================================================
# The MCP App sandbox must be a DISTINCT ORIGIN, so serve.ts binds two ports. A single App Service
# routes only one — deploy the ZIP to two Web Apps, or front them with a gateway exposing both.
HOST_PORT=8080
SANDBOX_PORT=8081

# Also needs ORCHESTRATOR_URL and ENGAGEMENTS_MCP_URL from SHARED above.


# =============================================================================
# MCP transport hardening (mcp-core — applies to any MCP server built on it)
# =============================================================================
# Comma-separated allow-list; unset permits the local demo origins.
# MCP_CORS_ALLOWED_ORIGINS=https://chat.example.com
# Require an Authorization: Bearer token on every MCP request.
# MCP_REQUIRE_BEARER=true

# ── Entra ID on-behalf-of (mcp-core; cloud deployments only) ──
# Lets the middle tier exchange the caller's token for a downstream Azure token, instead of
# reaching Azure as itself. Unset locally — the demo uses DefaultAzureCredential / `az login`.
# Secret-free by design: authenticate with a certificate OR a federated managed-identity
# assertion (the default). A client secret is never used.
# AZURE_OBO_TENANT_ID falls back to AZURE_TENANT_ID; AZURE_OBO_CLIENT_ID to AZURE_CLIENT_ID.
# AZURE_OBO_TENANT_ID=
# AZURE_OBO_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# Path to the middle-tier certificate; omit to use workload identity federation instead.
# AZURE_OBO_CERTIFICATE_PATH=
# User-assigned managed identity that mints the federated assertion (omit for system-assigned).
# AZURE_OBO_FEDERATED_CLIENT_ID=
# Audience for the assertion exchange (default api://AzureADTokenExchange/.default).
# AZURE_TOKEN_EXCHANGE_AUDIENCE=
