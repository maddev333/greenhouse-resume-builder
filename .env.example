# Greenhouse Resume Builder — Environment Variables
#
# Auth model: every Azure service below accepts EITHER a key/connection string OR
# Microsoft Entra ID (managed identity). Leave the key BLANK to use managed identity
# via DefaultAzureCredential — this is the required posture for Azure Government / DoD IL5.
# Provide the keys only for local development against emulators or key-based resources.

# ── PostgreSQL ───────────────────────────────────────────────
# Either set DATABASE_URL, OR the discrete PG* variables below.
# DATABASE_URL=postgresql://user:password@host:5432/resume_builder?sslmode=require
PGHOST=<server>.postgres.database.azure.com
PGPORT=5432
PGDATABASE=resume_builder
PGUSER=<user-or-managed-identity-name>
# Omit PGPASSWORD to authenticate with Microsoft Entra ID (managed identity).
# When set, it is used directly (local dev / key-based auth).
PGPASSWORD=<password-or-blank-for-managed-identity>
# SSL: auto-enabled for *.postgres.database.azure.com hosts. Force with PGSSLMODE=require
# or DATABASE_SSL=true. Set PGSSL_REJECT_UNAUTHORIZED=false only to trust self-signed certs.
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true
# AAD token scope per cloud (managed identity only).
# Commercial: https://ossrdbms-aad.database.windows.net/.default | Gov: same host, .us is NOT used
PG_AAD_SCOPE=https://ossrdbms-aad.database.windows.net/.default
# Max connections in the pool.
PG_POOL_MAX=10

# ── Azure Blob Storage ───────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=<account>
# Provide EITHER an account key, OR a connection string, OR neither (managed identity).
AZURE_STORAGE_ACCOUNT_KEY=<key-or-blank>
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=raw
# Endpoint suffix per cloud. Commercial: core.windows.net | Gov/DoD: core.usgovcloudapi.net
AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# No shared secret: leave AZURE_OPENAI_API_KEY blank. Auth resolves in order: On-Behalf-Of of
# the signed-in user (see below), then managed identity (Cognitive Services OpenAI User role).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Token scope per cloud.
# Commercial: https://cognitiveservices.azure.com/.default | Gov: https://cognitiveservices.azure.us/.default
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# ── On-Behalf-Of (run Azure OpenAI as the signed-in user — no shared secret) ──
# Middle-tier app registration that performs the OBO token exchange.
AZURE_OBO_TENANT_ID=5a473923-b039-4a6d-b236-16c05b9d6420
AZURE_OBO_CLIENT_ID=6813db1d-7596-4f97-9060-ccbe4cc57ec1
# How the middle tier proves its own identity during the exchange (never a client secret):
#   - Cloud: leave the cert path blank to use a federated managed-identity assertion
#     (workload identity federation). Optionally set the user-assigned MI client id below.
#   - Local: set AZURE_OBO_CERTIFICATE_PATH to a PEM cert registered on the app above.
AZURE_OBO_CERTIFICATE_PATH=
AZURE_OBO_FEDERATED_CLIENT_ID=
AZURE_TOKEN_EXCHANGE_AUDIENCE=api://AzureADTokenExchange/.default
# Local OBO testing only: a user access token whose audience is AZURE_OBO_CLIENT_ID.
AOAI_USER_ASSERTION=

# ── Azure AI Document Intelligence ───────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# Omit AZURE_DOCUMENT_INTELLIGENCE_KEY to use managed identity.
AZURE_DOCUMENT_INTELLIGENCE_KEY=<key-or-blank>
# Audience for sovereign clouds (managed identity only). Gov: https://cognitiveservices.azure.us
AZURE_DOCUMENT_INTELLIGENCE_AUDIENCE=

# ── Azure AI Search ──────────────────────────────────────────
AZURE_SEARCH_SERVICE=<search-service-name>
# Omit AZURE_SEARCH_API_KEY to use managed identity (Search Index Data Contributor role).
AZURE_SEARCH_API_KEY=<admin-key-or-blank>
# Endpoint suffix per cloud. Commercial: search.windows.net | Gov/DoD: search.azure.us
AZURE_SEARCH_ENDPOINT_SUFFIX=search.windows.net

# ── Azure Maps (geocoding) ───────────────────────────────────
# Local dev: provide AZURE_MAPS_KEY (subscription key). For managed identity instead,
# leave the key blank and set AZURE_MAPS_CLIENT_ID to the Maps account's client id.
AZURE_MAPS_KEY=<maps-subscription-key-or-blank>
AZURE_MAPS_CLIENT_ID=
# Endpoint per cloud. Commercial default below; set explicitly for Azure Government.
AZURE_MAPS_ENDPOINT=https://atlas.microsoft.com
# Token scope (managed identity only). Commercial: https://atlas.microsoft.com/.default
AZURE_MAPS_TOKEN_SCOPE=https://atlas.microsoft.com/.default

# ── Microsoft Entra ID (API auth) ────────────────────────────
AZURE_TENANT_ID=<tenant-id>
AZURE_AD_CLIENT_ID=<api-app-registration-client-id>
AZURE_AD_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# Accepted token issuer prefixes (comma-separated). Override for Gov/DoD.
# Commercial: https://sts.windows.net/,https://login.microsoftonline.com/
# Gov/DoD:    https://login.microsoftonline.us/,https://sts.windows.net/
AZURE_AD_ISSUER_PREFIXES=https://sts.windows.net/,https://login.microsoftonline.com/
# Authority host for DefaultAzureCredential. Gov/DoD: https://login.microsoftonline.us
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
# Local dev ONLY: set to 'true' to bypass cryptographic token verification. Never set in prod.
ALLOW_DEV_AUTH_BYPASS=false

# ── Azure Functions (Durable) ────────────────────────────────
AzureWebJobsStorage=DefaultEndpointsProtocol=https;...

PORT=3001
NODE_ENV=development
