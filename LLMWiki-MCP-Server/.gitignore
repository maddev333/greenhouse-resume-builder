# Local-only artifacts. The corpus and wiki folders are gitignored on purpose:
# corpus/ holds the operator's raw sources; wiki/ holds LLM-authored notes
# that you typically version in a separate repo. The parsed/ and index/
# folders are entirely machine-generated.
data/corpus/*
!data/corpus/.gitkeep
data/wiki/*
!data/wiki/.gitkeep
data/parsed/*
!data/parsed/.gitkeep
data/index/*
!data/index/.gitkeep

.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
