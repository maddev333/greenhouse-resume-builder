# ── LLMWiki FastMCP Server ───────────────────────────────────────

# Storage backend:
#   auto        — local dev default (SQLite).
#   sqlite      — force the local SQLite wiki.
#   azure       — LLM-authored wiki on Azure AI Search (wiki-* indexes).
#   azure-facts — READ-ONLY adapter over the greenhouse-resume-builder
#                 `resume-facts` index (see the azure-facts block below).
LLMWIKI_STORAGE_MODE=auto

# ── Azure AI Search (Phase 1) ────────────────────────────────────
# Optional: Azure AI Search service URL (discovered via managed identity by default).
# Set to enable the Azure backend at runtime.
LLMWIKI_AZURE_SEARCH_SERVICE_URL=https://<your-search-service>.search.windows.net

# Optional: tenant ID for security trim in Azure mode. Falls back to
# DefaultAzureCredential environment variables (AZURE_TENANT_ID, etc.).
LLMWIKI_AZURE_SEARCH_TENANT_ID=

# ── Azure AI Search index names + schema (optional) ──────────────
# The three indexes default to wiki-{sections,documents,concepts}. Override the
# shared prefix to rename all three at once, or set any index name explicitly.
# Lets one Search service host multiple logical wikis.
# LLMWIKI_AZURE_SEARCH_INDEX_PREFIX=wiki
# LLMWIKI_AZURE_SEARCH_SECTIONS_INDEX=wiki-sections
# LLMWIKI_AZURE_SEARCH_DOCUMENTS_INDEX=wiki-documents
# LLMWIKI_AZURE_SEARCH_CONCEPTS_INDEX=wiki-concepts
# bodyVector dimensions — MUST match your embedding model
# (text-embedding-3-small=1536, text-embedding-3-large=3072).
# LLMWIKI_AZURE_SEARCH_VECTOR_DIMENSIONS=1536
# Auto-create any missing indexes at startup (needs the Azure RBAC role
# 'Search Service Contributor'). Set to false once indexes exist.
LLMWIKI_AZURE_SEARCH_AUTO_PROVISION=true

# Required Azure SDK env vars when using managed identity / non-local auth:
# AZURE_CLIENT_ID=<your-client-id>
# AZURE_CLIENT_SECRET=<your-client-secret>  # or use device_code via `az login`

# ── Read-only adapter over greenhouse `resume-facts` (azure-facts mode) ──
# Set LLMWIKI_STORAGE_MODE=azure-facts to expose the existing resume-facts
# index (populated by greenhouse-resume-builder) through the standard wiki
# tools — WITHOUT creating any indexes. Mapping:
#   person (personId) -> Document   (title = the profile.name fact)
#   resume sectionId  -> Collection (profile/experience/skills/summary/education)
#   each fact/bullet  -> Section
#
# IMPORTANT — tenant must equal the DATA tenant, not the Entra auth tenant.
#   resume-facts rows carry tenantId="tenant-dev" (the pipeline's data tenant),
#   so LLMWIKI_AZURE_SEARCH_TENANT_ID must be "tenant-dev" here, NOT the Entra
#   GUID used elsewhere. Queries fail closed if no tenant is set.
# LLMWIKI_STORAGE_MODE=azure-facts
# LLMWIKI_AZURE_SEARCH_TENANT_ID=tenant-dev
# Index name (default: resume-facts) + its semantic config (default: semantic-config).
# LLMWIKI_AZURE_SEARCH_FACTS_INDEX=resume-facts
# LLMWIKI_AZURE_SEARCH_FACTS_SEMANTIC_CONFIG=semantic-config
# Sensitive facts (factKey event.* / *.location) are REDACTED by default,
# mirroring greenhouse FACTS_SENSITIVE_READ_ROLES. Opt in for privileged callers:
# LLMWIKI_FACTS_ALLOW_SENSITIVE=false
#
# Limits & scaling: the live resume-facts index marks NO fields filterable, so
# this adapter trims tenant/section/sensitive predicates client-side (secure —
# no cross-tenant leakage, but lower recall at large multi-tenant scale). For
# server-side pushdown, mark tenantId/personId/sectionId/factKey filterable in
# the greenhouse index definition (api/src/search/index.ts).

# ── Standard LLMWiki settings (unchanged) ────────────────────────
LLMWIKI_HOST=127.0.0.1
LLMWIKI_PORT=8765
LLMWIKI_WATCH_INTERVAL_SECONDS=30
LLMWIKI_DEFAULT_COLLECTION=default
LLMWIKI_WIKI_COLLECTION=wiki
LLMWIKI_MAX_READ_CHARS=20000
LLMWIKI_MAX_SECTION_CHARS=4000

# ── Azure Document Intelligence (optional, existing) ─────────────
# LLMWIKI_DOC_INTEL_ENDPOINT=https://<your-doc-intel>.cognitiveservices.azure.com/
# LLMWIKI_DOC_INTEL_API_KEY=<key>  # or use DefaultAzureCredential
LLMWIKI_DOC_INTEL_MODEL=prebuilt-layout
