# ── LLMWiki FastMCP Server ───────────────────────────────────────

# Local dev (default — SQLite). Set LLMWIKI_STORAGE_MODE=azure for Azure mode.
LLMWIKI_STORAGE_MODE=auto

# ── Azure AI Search (Phase 1) ────────────────────────────────────
# Optional: Azure AI Search service URL (discovered via managed identity by default).
# Set to enable the Azure backend at runtime.
LLMWIKI_AZURE_SEARCH_SERVICE_URL=https://<your-search-service>.search.windows.net

# Optional: tenant ID for security trim in Azure mode. Falls back to
# DefaultAzureCredential environment variables (AZURE_TENANT_ID, etc.).
LLMWIKI_AZURE_SEARCH_TENANT_ID=

# Required Azure SDK env vars when using managed identity / non-local auth:
# AZURE_CLIENT_ID=<your-client-id>
# AZURE_CLIENT_SECRET=<your-client-secret>  # or use device_code via `az login`

# ── Standard LLMWiki settings (unchanged) ────────────────────────
LLMWIKI_HOST=127.0.0.1
LLMWIKI_PORT=8765
LLMWIKI_WATCH_INTERVAL_SECONDS=30
LLMWIKI_DEFAULT_COLLECTION=default
LLMWIKI_WIKI_COLLECTION=wiki
LLMWIKI_MAX_READ_CHARS=20000
LLMWIKI_MAX_SECTION_CHARS=4000

# ── Azure Document Intelligence (optional, existing) ─────────────
# LLMWIKI_DOC_INTEL_ENDPOINT=https://<your-doc-intel>.cognitiveservices.azure.com/
# LLMWIKI_DOC_INTEL_API_KEY=<key>  # or use DefaultAzureCredential
LLMWIKI_DOC_INTEL_MODEL=prebuilt-layout
